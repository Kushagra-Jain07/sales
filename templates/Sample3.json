{
  "pipeline_name": "customer_ingestion3",
  "environment": "dev",
  "source": {
    "type": "adls",
    "path": "abfss://raw@storageaccount.dfs.core.windows.net/customer/",
    "format": "json"
  },
  "target": {
    "catalog": "dev_catalog",
    "schema": "gold",
    "table": "customer"
  },
  "processing": {
    "load_type": "incremental",
    "watermark_column": "updated_timestamp",
    "primary_key": "customer_id"
  },
  "schedule": {
    "frequency": "daily",
    "start_time": "02:00"
  },
  "notifications": {
    "on_failure": true,
    "email": "data-engineering@example.com"
  }
}
